# Copiar como .env antes de `npm run dev` o `npm run build`.
# Todo lo que empieza con VITE_ termina en el bundle y es publico: no poner secretos aca.

# URL del backend (obligatoria). Si falta, la app muestra un error en la consola y no llama a la API.
# Con "/" usa rutas relativas (/api/...) que el proxy de Vite manda a http://localhost:8080: sirve para abrir
# el sitio desde otro dispositivo de la red (ver "Probar desde el celular" en el README).
VITE_API_URL=http://localhost:8080
