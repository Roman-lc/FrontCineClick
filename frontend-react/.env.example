# Todo lo que empieza con VITE_ termina en el bundle y es publico: no poner secretos aca.

# true: los servicios responden con los datos de src/mocks (no hace falta el backend).
# false: llaman a la API real.
VITE_USE_MOCKS=true

# Solo con mocks: true hace fallar todas las respuestas para ver los estados de error.
VITE_MOCK_ERROR=false

# Host del backend. Vacio = rutas relativas /api/..., que en desarrollo pasan por el proxy de Vite
# hacia http://localhost:8080 (ver vite.config.js).
VITE_API_BASE_URL=
